{
  "expo": {
    "name": "Mylife",
    "slug": "Mylife",
    "version": "1.0.0",
    "scheme": "mylife",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#060608",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#060608",
          "image": "./assets/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "dark",
      "bundleIdentifier": "com.mylife.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Mylife nutzt Face ID, um deine persönlichen Daten zu schützen."
      }
    },
    "android": {
      "userInterfaceStyle": "dark",
      "package": "com.mylife.app",
      "adaptiveIcon": {
        "backgroundColor": "#060608",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "lang": "de",
      "themeColor": "#060608",
      "backgroundColor": "#060608",
      "description": "Persönlicher KI-Lebensassistent"
    }
  }
}
